# plantilla de entorno — copiar a .env (nunca se versiona .env)
# cp .env.example .env

# ---------------------------------------------------------------------------
# DApp objetivo (DEX). La suite principal mockea red y RPC: el target real
# sólo se usa dentro de un adapter (ver docs/plan.md).
# ---------------------------------------------------------------------------
# BASE_URL=https://app.uniswap.org
BASE_URL=https://app.uniswap.org

# ---------------------------------------------------------------------------
# Red objetivo (src/config/networks.ts):
#   mainnet | polygon | arbitrum | optimism | base | sepolia
# Por defecto sepolia. `mainnet` exige ALLOW_MAINNET=true (opt-in explícito).
# ---------------------------------------------------------------------------
NETWORK=sepolia
# ALLOW_MAINNET=false

# DApp objetivo de los E2E: sandbox (local, determinista, por defecto) | uniswap (referencia)
DAPP_TARGET=sandbox

# ---------------------------------------------------------------------------
# Capa RPC on-chain (pruebas @web3 opcionales, Fase 3+).
# RPC_URL: endpoint sin llaves o con llave vía secreto de CI. Nunca subirlo aquí.
# PRIVATE_KEY: wallet de prueba SOLO entornos efímeros (fork local / Anvil).
#   env.ts solo la acepta si RPC_URL apunta a localhost/127.0.0.1. Hoy ninguna
#   suite la usa: déjala vacía salvo que lo necesites.
# Las URLs no deben llevar usuario:contraseña; las llaves van por secretos de CI.
# Se accede vía src/config/env.ts y jamás se imprime en logs ni reportes.
# ---------------------------------------------------------------------------
RPC_URL=
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Pruebas contractuales opcionales contra servicios reales (Fase 5+).
# CONTRACTUAL_API=true activa los casos @api que tocan api.coingecko.com.
# Déjala desactivada: la suite normal es determinista (docs/plan.md).
# ---------------------------------------------------------------------------
# CONTRACTUAL_API=false

# ---------------------------------------------------------------------------
# Duraciones (ms) — sobrescriben los valores por defecto de src/config/env.ts
# ---------------------------------------------------------------------------
# HEADLESS=true
# TEST_TIMEOUT_MS=45000
# NAVIGATION_TIMEOUT_MS=30000
# ACTION_TIMEOUT_MS=15000
# EXPECT_TIMEOUT_MS=10000
